{
    "compilerOptions": {
        "outDir": "../backend_dist",
        "rootDir": "../",
        "target": "esnext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "module": "nodenext",
        "allowSyntheticDefaultImports": true,
        "lib": ["ESNext", "DOM"],
        "strict": true
    },
    "include": ["./**/*", "../shared/**/*"],
    "exclude": ["../frontend/**/*", "node_modules"]
}