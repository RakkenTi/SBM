{
    "compilerOptions": {
        "outDir": "../backend_dist",
        "rootDir": "../",
        "target": "esnext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "module": "nodenext",
        "lib": ["ESNext", "DOM"],
    },
    "include": [
        "./**/*",
        "../shared/**/*"
    ],
    "exclude": [
        "../frontend/**/*",
        "node_modules"
    ]
}
